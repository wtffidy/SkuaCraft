<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>SkuaCraft.PlayerHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\vendor\MVS\src\Skua.Core\Skua.Core.csproj" />
    <ProjectReference Include="..\vendor\MVS\src\Skua.Flash.Ruffle\Skua.Flash.Ruffle.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ScriptCatalogue.json" LogicalName="SkuaCraft.PlayerHost.ScriptCatalogue.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\vendor\MVS\src\Skua.App.Avalonia\AdvancedSkills.json" Link="AdvancedSkills.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\vendor\MVS\src\Skua.App.Avalonia\QuestData.json" Link="QuestData.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
